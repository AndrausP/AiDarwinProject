{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Criatura IA Protocol v1",
  "version": 1,
  "endianness": "little",
  "frame": {
    "layout": ["u32 body_length", "u8 message_type", "bytes payload"],
    "bodyLengthIncludes": ["message_type", "payload"],
    "maxBodyLength": 67108864
  },
  "dimensions": { "observation": 697, "action": 10 },
  "messageTypes": {
    "HELLO": 1,
    "CONFIG": 2,
    "STEP": 3,
    "ACT": 4,
    "SPAWN": 5
  },
  "eventTypes": { "DEATH": 1, "MATE_REQUEST": 2, "ATE": 3, "DAMAGED": 4 },
  "deathCauses": {
    "NONE": 0,
    "STARVATION": 1,
    "DEHYDRATION": 2,
    "COLD": 3,
    "HEAT": 4,
    "HEAD_INJURY": 5,
    "TORSO_INJURY": 6,
    "AGE": 7,
    "FALL": 8,
    "BITE": 9
  },
  "flow": {
    "lockstep": "Godot sends STEP(tick) and pauses; Python answers with zero or more SPAWN frames followed by exactly one ACT(tick).",
    "spawn": "SPAWN ids must be new (never reused). The spawned creature is created before physics resumes and first appears in STEP(tick+1). It is not part of ACT(tick).",
    "traits": "trait_count 0 = default BodyTraits (no genome before phase 4)."
  },
  "messages": {
    "HELLO": ["u16 version", "u16 observation_dim", "u16 action_dim", "u64 world_seed"],
    "CONFIG": ["f32 time_scale", "u16 physics_hz", "u16 brain_hz", "u16 population"],
    "STEP": ["u64 tick", "u16 agent_count", "agent_count * (u32 id + 697*f32 observation)", "u16 event_count", "event_count * (u8 type + u16 length + bytes payload)"],
    "ACT": ["u64 tick", "u16 agent_count", "agent_count * (u32 id + 10*f32 action)"],
    "SPAWN": ["u32 id", "u16 trait_count", "trait_count*f32 traits", "u8 has_position", "if has_position: 3*f32 position"]
  }
}
